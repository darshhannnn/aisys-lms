# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AISYS Library Management System"
ENVIRONMENT=development
DEBUG=false

# IMPORTANT: Change SECRET_KEY to a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aisys:aisys@localhost:5432/aisys_lms
DATABASE_URL_SYNC=postgresql+psycopg2://aisys:aisys@localhost:5432/aisys_lms

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── RFID ──────────────────────────────────────────────────────────────────────
# Use "mock" for development/testing (no physical hardware required)
RFID_ADAPTER=mock
NCIP_ENDPOINT=http://localhost:9000/ncip
SIP2_HOST=localhost
SIP2_PORT=6001

# ── Notifications ─────────────────────────────────────────────────────────────
# Use "mock" — emails are logged but not sent
EMAIL_ADAPTER=mock
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=library@aisys.local

SMS_ADAPTER=mock

# ── Circulation rules ─────────────────────────────────────────────────────────
DEFAULT_LOAN_DAYS=14
MAX_RENEWALS=2
MAX_FINE_BEFORE_BLOCK=50.00
FINE_PER_DAY=1.00

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console
